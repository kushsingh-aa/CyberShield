# ========================================================
# CyberShield — Zero-Dataset AI & Intelligence Configuration
# ========================================================
# Obtain a free Google Gemini API key at:
# https://aistudio.google.com/app/apikey

GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# (Optional) Anthropic Claude API key:
ANTHROPIC_API_KEY=""

# (Optional) Google Safe Browsing API v4:
SAFE_BROWSING_KEY=""

# (Optional) VirusTotal API v3:
VIRUSTOTAL_API_KEY=""

# (Optional) Supabase Postgres:
SUPABASE_URL=""
SUPABASE_KEY=""

# ========================================================
# Server settings (all optional)
# ========================================================
# Origins allowed to call the API (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Secret used to hash reporter identities for community reports. Set a long random value in production.
REPORT_SALT=""

# Where the local SQLite database lives (defaults to backend/cybershield_local.db)
CYBERSHIELD_DB_PATH=""
